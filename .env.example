# Copy to .env for local runs (never commit .env). Nothing here is needed for `npm run dev`:
# without AWS settings the app uses the in-memory repo, the rules brain and simulated delivery.

PORT=3000
# Signs household tokens. Local dev generates a random one if empty. In AWS it comes from SSM
# /haven/household-secret (at least 32 characters).
HOUSEHOLD_SECRET=
# Extra allowed browser Origins, comma-separated (same-origin is always allowed).
ALLOWED_ORIGINS=
# Built web app to serve (default web/dist).
WEB_DIR=
PUBLIC_DEMO_ID=public-demo

# AWS (ap-south-1). Leave empty locally unless you are testing against real services.
AWS_REGION=ap-south-1
TABLE_NAME=
MEDIA_BUCKET=
SSM_PREFIX=/haven/
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_FALLBACK_MODEL_ID=apac.amazon.nova-lite-v1:0
POLLY_VOICE_PRIYA=Kajal
# Neural male voice for the simulated Alexa+ lines (confirmed in ap-south-1 on 16 Oct).
POLLY_VOICE_SYSTEM=Brian

# Model bake-off override (comma-separated model ids).
BAKEOFF_MODELS=
